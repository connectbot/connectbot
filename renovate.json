{
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^gradle\\/mosh4android\\.version$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+(?<currentValue>android-[^\\s]+)"],
      "versioningTemplate": "{{{versioning}}}"
    }
  ]
}
